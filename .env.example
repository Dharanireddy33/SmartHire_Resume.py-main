# Example environment variables for SmartHire
# Copy this file to `.env` locally and fill values. Do NOT commit `.env`.

# If your resume dataset is hosted remotely, provide the URL here.
# Otherwise provide a project-relative or absolute path.
DATA_URL=
DATA_PATH=
RESUME_DATASET_PATH=

# Optional: path to a serialized model if loading externally
MODEL_PATH=

# Optional: path to job listings CSV
JOBS_PATH=jobs.csv

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Streamlit settings
STREAMLIT_SERVER_HEADLESS=true

# Cloud storage credentials (if used) - keep these secret
S3_KEY=
S3_SECRET=
